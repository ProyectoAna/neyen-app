{
    "name": "WF-01: Ingestion Pipeline",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "wf01-ingest",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{$json.body.type}}",
                            "operation": "equal",
                            "value2": "url_verification"
                        }
                    ]
                }
            },
            "id": "check-url-verification",
            "name": "Check URL Verification",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={\"challenge\": \"{{ $json.body.challenge }}\"}"
            },
            "id": "respond-challenge",
            "name": "Respond Challenge",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                650,
                150
            ]
        },
        {
            "parameters": {
                "functionCode": "// Extract fields from Slack Events API payload\n// Slack wraps messages under body.event, not body directly\nconst body = $input.item.json.body || $input.item.json;\nconst event = body.event || {};\n\n// Ignore retried events that we may have already processed\n// (Slack adds X-Slack-Retry-Num header on retries, but we handle via event_id dedup in Supabase)\n\n// Skip bot messages to prevent infinite loops\nif (event.bot_id || event.subtype === 'bot_message') {\n  return null;\n}\n\n// Only process standard user messages\nif (event.type !== 'message' || !event.text) {\n  return null;\n}\n\nreturn {\n  json: {\n    message_text: event.text,\n    user_id: event.user || 'anonymous',\n    channel_id: event.channel || '',\n    source: 'slack',\n    event_id: body.event_id || '',\n    timestamp: event.ts\n      ? new Date(parseFloat(event.ts) * 1000).toISOString()\n      : new Date().toISOString(),\n    metadata: {}\n  }\n};"
            },
            "id": "extract-content",
            "name": "Extract Content",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                650,
                400
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{$json.message_text}}",
                            "operation": "isNotEmpty"
                        }
                    ],
                    "number": [
                        {
                            "value1": "={{$json.message_text.length}}",
                            "operation": "largerEqual",
                            "value2": 10
                        }
                    ]
                }
            },
            "id": "filter-messages",
            "name": "Filter Messages",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                850,
                400
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "{\"status\": \"ok\"}"
            },
            "id": "respond-ack",
            "name": "Respond ACK to Slack",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1050,
                400
            ]
        },
        {
            "parameters": {
                "functionCode": "// Build the Claude API request body\nconst messageText = $input.item.json.message_text || '';\nconst source = $input.item.json.source || 'unknown';\nconst timestamp = $input.item.json.timestamp || new Date().toISOString();\n\nconst prompt = `Analyze this message and extract metadata:\n\nMessage: ${messageText}\nSource: ${source}\nTimestamp: ${timestamp}\n\nExtract and return ONLY valid JSON (no markdown, no explanation):\n{\n  \"tags\": [\"tag1\", \"tag2\", \"tag3\"],\n  \"entities\": [\"entity1\", \"entity2\"],\n  \"summary\": \"1-2 sentence summary\",\n  \"narrative_role\": \"symbol|system|pilot|origin|exploration|setup|conflict|realisation|integration\",\n  \"date_estimated\": \"YYYY-MM-DD or YYYY\",\n  \"timeline_group\": \"1974-1990|2019-2023|2024-2026\"\n}\n\nRules:\n- Tags: 3-5 keywords\n- Entities: People, companies, concepts\n- Summary: Concise, factual\n- Narrative_role: Best fit from list\n- Date_estimated: Infer from context or use timestamp\n- Timeline_group: Map to period`;\n\nreturn {\n  json: {\n    ...$input.item.json,\n    claudeRequestBody: JSON.stringify({\n      model: 'claude-haiku-4-5-20251001',\n      max_tokens: 1024,\n      messages: [{role: 'user', content: prompt}]\n    })\n  }\n};"
            },
            "id": "build-claude-request",
            "name": "Build Claude Request",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                1050,
                350
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.anthropic.com/v1/messages",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "anthropic-version",
                            "value": "2023-06-01"
                        },
                        {
                            "name": "content-type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "contentType": "raw",
                "rawContentType": "application/json",
                "body": "={{ $json.claudeRequestBody }}",
                "options": {}
            },
            "id": "claude-classify",
            "name": "Claude API Classification",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                1250,
                350
            ]
        },
        {
            "parameters": {
                "functionCode": "// Parse Claude API response\nconst response = $input.item.json;\nconst content = response.content && response.content[0] && response.content[0].text;\n\nif (!content) {\n  throw new Error('No content in Claude response');\n}\n\n// Strip markdown code fences if Claude added them\nlet jsonText = content.trim();\nif (jsonText.startsWith('```json')) {\n  jsonText = jsonText.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n} else if (jsonText.startsWith('```')) {\n  jsonText = jsonText.replace(/```\\n?/g, '').trim();\n}\n\nconst classified = JSON.parse(jsonText);\n\n// Pull original message data from Extract Content node\nconst originalData = $node['Extract Content'].json;\n\n// Generate a stable file_name using event_id when available\nconst suffix = originalData.event_id || new Date().getTime();\nconst file_name = `auto_slack_${suffix}`;\n\nreturn {\n  json: {\n    file_name: file_name,\n    type: null,\n    summary: classified.summary || '',\n    tags: classified.tags || [],\n    entities: classified.entities || [],\n    emotional_tone: null,\n    source: originalData.source,\n    themes: [],\n    concepts: [],\n    keywords: [],\n    mime_type: 'text/plain',\n    cluster: null,\n    related_ids: [],\n    date_estimated: classified.date_estimated || new Date().toISOString().split('T')[0],\n    timeline_group: classified.timeline_group || '2024-2026',\n    narrative_role: classified.narrative_role || 'exploration'\n  }\n};"
            },
            "id": "parse-classification",
            "name": "Parse Classification",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                1450,
                400
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "tableId": "metadata",
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "file_name": "={{$json.file_name}}",
                        "type": "={{$json.type}}",
                        "summary": "={{$json.summary}}",
                        "tags": "={{$json.tags}}",
                        "entities": "={{$json.entities}}",
                        "emotional_tone": "={{$json.emotional_tone}}",
                        "source": "={{$json.source}}",
                        "themes": "={{$json.themes}}",
                        "concepts": "={{$json.concepts}}",
                        "keywords": "={{$json.keywords}}",
                        "mime_type": "={{$json.mime_type}}",
                        "cluster": "={{$json.cluster}}",
                        "related_ids": "={{$json.related_ids}}",
                        "date_estimated": "={{$json.date_estimated}}",
                        "timeline_group": "={{$json.timeline_group}}",
                        "narrative_role": "={{$json.narrative_role}}"
                    }
                }
            },
            "id": "supabase-insert",
            "name": "Supabase Insert",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                1650,
                400
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "supabase-credentials",
                    "name": "Supabase API"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-docker-t9sr.onrender.com/webhook/wf02-crosslink",
                "options": {}
            },
            "id": "trigger-crosslink",
            "name": "Trigger WF-02",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                1850,
                400
            ]
        }
    ],
