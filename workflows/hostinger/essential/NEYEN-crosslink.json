{
  "name": "NEYEN Crosslink",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf02-crosslink",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "wf02-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "wf02-crosslink",
      "credentials": {
        "httpHeaderAuth": {
          "id": "pending-hostinger",
          "name": "Internal Webhook Header"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Extract file_name from incoming webhook body\nconst body = $input.item.json.body || $input.item.json;\nconst fileName = body.file_name;\n\nif (!fileName) {\n  throw new Error('No file_name in payload. Keys: ' + Object.keys(body).join(', '));\n}\n\nreturn {\n  json: { file_name: fileName, channel_id: body.channel_id || '' }\n};"
      },
      "id": "extract-filename",
      "name": "Extract File Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const prev = $('Extract File Name').item.json;\nconst result = $input.item.json;\nreturn { json: { ...prev, ...result, crosslink_result: result } };\n"
      },
      "id": "call-crosslink-rpc",
      "name": "Call Crosslink RPC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond-result",
      "name": "Respond Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.related_count }}",
              "operation": "largerEqual",
              "value2": 5
            }
          ]
        }
      },
      "id": "check-threshold",
      "name": "5+ Crosslinks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const rpcResult = $input.item.json;\nreturn { json: { ...rpcResult, route: 'notify' } };\n"
      },
      "id": "trigger-wf03",
      "name": "Trigger WF-03 Notify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gsmtzdramqzcqdywboro.supabase.co/rest/v1/rpc/crosslink_entry",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_file_name: $json.file_name }) }}"
      },
      "id": "http-call-crosslink-rpc",
      "name": "Credencial Call Crosslink RPC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        440
      ],
      "credentials": {
        "supabaseApi": {
          "id": "pending-hostinger",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.thespiralwithin.ai/webhook/wf03-crosslink-notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "call-wf03",
      "name": "Llamar WF-03",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1270,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pending-hostinger",
          "name": "Internal Webhook Header"
        }
      }
    }
  ],
  "connections": {
