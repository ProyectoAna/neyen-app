        "functionCode": "const prev = $('Route /tag Command').item.json;\nconst result = $input.item.json;\nconst related = (result.crosslink || {}).related_count || 0;\nconst values = (prev.values || []).map(v => '`' + v + '`').join(' ');\nconst text = result.status === 'ok'\n  ? `:white_check_mark: *Tag aplicado*\\n*Entrada:* \\`${prev.file_name}\\`\\n*Campo:* \\`${prev.field}\\` → ${values}\\n*Conexiones:* ${related}`\n  : `:x: *Error al aplicar /slowest-tag*\\n\\`${prev.file_name}\\` — ${result.message || 'Error desconocido'}`;\nreturn { json: { ...prev, rpc_result: result, slack_text: text, channel_id: prev.channel_id } };\n"
      },
