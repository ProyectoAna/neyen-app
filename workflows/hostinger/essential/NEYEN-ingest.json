    {
      "parameters": {
        "functionCode": "// Extract fields from Slack Events API payload\n// Slack wraps messages under body.event, not body directly\nconst body = $input.item.json.body || $input.item.json;\nconst event = body.event || {};\n\n// Ignore retried events that we may have already processed\n// (Slack adds X-Slack-Retry-Num header on retries, but we handle via event_id dedup in Supabase)\n\n// Skip bot messages to prevent infinite loops\nif (event.bot_id || event.subtype === 'bot_message') {\n  return null;\n}\n\n// Only process standard user messages\nif (event.type !== 'message' || !event.text) {\n  return null;\n}\n\nreturn {\n  json: {\n    message_text: event.text,\n    user_id: event.user || 'anonymous',\n    channel_id: event.channel || '',\n    source: 'slack',\n    event_id: body.event_id || '',\n    timestamp: event.ts\n      ? new Date(parseFloat(event.ts) * 1000).toISOString()\n      : new Date().toISOString(),\n    metadata: {}\n  }\n};"
      },
      "id": "extract-content",
      "name": "Extract Content",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {
        "functionCode": "const msg = $input.item.json;\nconst text = (msg.message_text || '').trim();\nconst slowTagMatch = text.match(/^\\/slowest-tag\\s+(\\S+)\\s+(\\S+)\\s+(.+)$/i);\n\nif (slowTagMatch || text === '/slowest-tag' || text.startsWith('/slowest-tag ') || text.startsWith('/slowest-tag\\t')) {\n  if (!slowTagMatch) {\n    return { json: { ...msg, route: 'slack', slack_text: ':seedling: *Uso:* `/slowest-tag <file_name> <field> <valores>`' } };\n  }\n  const [, fileName, field, valuesStr] = slowTagMatch;\n  const values = valuesStr.trim().split(/\\s+/).filter(Boolean);\n  const validFields = ['tags', 'entities', 'narrative_role'];\n  const validRoles = ['realisation', 'exploration', 'conflict', 'symbol', 'system', 'orphaned'];\n  let errMsg = null;\n  if (!validFields.includes(field)) errMsg = `:x: Campo inválido: \\`${field}\\``;\n  else if (field === 'narrative_role' && !validRoles.includes(values[0])) errMsg = `:x: Rol inválido: \\`${values[0]}\\``;\n  if (errMsg) return { json: { ...msg, route: 'slack', slack_text: errMsg } };\n  return { json: { ...msg, route: 'slowest', file_name: fileName, field, values } };\n}\n\nconst toTagger = text.startsWith('/tag ') || text.startsWith('/tag\\t') || text === '/graph' || text.startsWith('/graph ') || text.startsWith('/history ') || text.startsWith('/history\\t') || text.startsWith('/compare ') || text.startsWith('/compare\\t') || text.startsWith('/trend ') || text.startsWith('/trend\\t') || text === '/leaderboard' || text.startsWith('/leaderboard ') || text.startsWith('/leaderboard\\t');\nif (toTagger) {\n  return { json: { ...msg, route: 'wf05', forward: { body: { text, user_id: msg.user_id || '', channel_id: msg.channel_id || '', ts: msg.timestamp || '' } } } };\n}\nif (text.startsWith('/search ') || text.startsWith('/search\\t')) {\n  return { json: { ...msg, route: 'wf06', forward: { body: { text, user_id: msg.user_id || '', channel_id: msg.channel_id || '', ts: msg.timestamp || '' } } } };\n}\nreturn { json: { ...msg, route: 'content' } };\n"
      },
