# Copie a .env FUERA del repositorio (o use las variables del servicio en Easypanel). Nunca suba valores reales.
SLACK_SIGNING_SECRET=
N8N_BASE_URL=http://n8n:5678
N8N_INTERNAL_HEADER_NAME=X-Neyen-Internal
N8N_INTERNAL_HEADER_VALUE=
# Opcionales: SQLITE_PATH=/data/events.sqlite PORT=8080 WORKER_POLL_SECONDS=2 SHUTDOWN_GRACE_SECONDS=35 SLACK_EVENTS_PATH=/slack/events
